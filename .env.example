# Proveedor de LLM
LLM_PROVIDER=nvidia            # nvidia | deepseek
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # vacío = default del proveedor
LLM_TIMEOUT=120                # segundos por llamada al modelo (vacío = 120)

# Claves (solo hace falta la del proveedor elegido)
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# Imágenes (opcional)
UNSPLASH_ACCESS_KEY=
